# ---------------------------------------------------------------------------
# SaveDesk — environment variables
#
# Local development: copy this file to `.env` (git-ignored) and fill in what you
# need. Production (Vercel): do NOT commit a .env — set the same names in
# Project → Settings → Environment Variables, then redeploy.
# ---------------------------------------------------------------------------

# --- Frontend (build-time, baked into the public bundle; never put secrets here)

# Base URL of the API. LEAVE EMPTY for the recommended deployment, where the SPA
# and /api/* live in the same Vercel project (same origin → no CORS at all, and
# requests go to relative /api/... URLs).
#
# Set it only when the API is on a different origin, or for the Electron desktop
# build: the desktop app loads the bundle from file:// and therefore needs an
# absolute URL, e.g. VITE_API_URL="https://your-app.vercel.app".
VITE_API_URL=""

# --- Serverless API (server-side only; Vercel env vars, never VITE_*)

# PostgreSQL connection string. Free options: Neon (https://neon.tech) or
# Supabase (https://supabase.com). Keep `sslmode=require` for cloud databases.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session tokens (HMAC-SHA256). Minimum 16 characters,
# 32+ random bytes recommended. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing session (users must sign in again).
AUTH_SECRET="replace-with-64-hex-characters"

# --- Optional

# Comma-separated list of origins allowed to call the API from a browser.
# Not needed for same-origin deployments (the intended setup). Include the
# literal value `null` only if you want the Electron file:// build to reach a
# hosted API from the browser fetch path instead of the native transport.
# ALLOWED_ORIGINS="https://app.example.com"

# Legacy alias for AUTH_SECRET, still accepted for backwards compatibility.
# JWT_SECRET="..."
