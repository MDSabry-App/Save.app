{
  "name": "savedesk",
  "productName": "SaveDesk",
  "private": true,
  "version": "1.0.0",
  "description": "SaveDesk — Developer & Personal Utility Dashboard. Fast, private, desktop-ready productivity environment.",
  "author": "SaveDesk",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "vercel dev",
    "dev:desktop": "node scripts/electron-dev.cjs",
    "build": "vite build",
    "test:self": "node scripts/self-test.cjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:build": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "desktop:build": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.devdesk.desktop",
    "productName": "SaveDesk",
    "asar": true,
    "directories": {
      "output": "C:\\devdesk-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SaveDesk",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "SaveDesk — Developer and Personal Utility Dashboard"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^5.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}